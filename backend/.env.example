# Supabase cloud (Direct connection, puerto 5432):
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Tamaño del pool de conexiones a PostgreSQL.
# Aumentar DB_POOL_MAX en producción según carga esperada (recomendado: 20-50).
DB_POOL_MIN=1
DB_POOL_MAX=10

GEMINI_API_KEY=your-gemini-api-key

# Modelo de Gemini a usar. Cambiar sin redeploy si se migra a otro modelo.
GEMINI_MODEL=gemini-1.5-flash

# Horas que un consejo motivacional es válido antes de regenerarse.
# Valor bajo = consejos más frescos pero más llamadas a Gemini.
TIP_TTL_HOURS=24

FRONTEND_URL=http://localhost:5173
