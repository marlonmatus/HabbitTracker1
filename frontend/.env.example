# URL base del backend FastAPI
# En desarrollo local con Supabase CLI el backend corre en el puerto 8000
VITE_API_BASE_URL=http://localhost:8000

# ID del usuario activo en la sesión
# En producción esto vendrá del sistema de autenticación
# Para desarrollo local puedes usar cualquier UUID o string identificador
VITE_USER_ID=demo-user
